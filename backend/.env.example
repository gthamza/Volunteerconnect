NODE_ENV=development
PORT=3000

# Clerk verifies session tokens issued by the existing mobile application.
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# Comma-separated exact origins. Leave empty for a native-only API client.
CORS_ORIGINS=

SUPABASE_URL=https://your-project.supabase.co
# Server-only. Never put this key in the Expo app or any EXPO_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_server_only_supabase_service_role_key
